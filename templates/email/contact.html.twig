<div style="max-width: 600px; margin: auto; padding: 20px; background-color: #ffffff; border-radius: 8px; box-shadow: 0 0 15px rgba(0, 0, 0, 0.2); font-family: Arial, sans-serif;">
	<h1 style="font-size: 26px; font-weight: bold; color: #f97316; text-align: center;">Vous avez un nouveau contact</h1>
	<div style="margin-top: 20px; line-height: 1.6;">
		<p>
			<strong style="color: #333;">Nom:</strong>
			<span style="color: #555;">{{ lastName }}</span>
		</p>
		<p>
			<strong style="color: #333;">Prénom:</strong>
			<span style="color: #555;">{{ firstName }}</span>
		</p>
		<p>
			<strong style="color: #333;">N° Téléphone:</strong>
			<span style="color: #555;">{{ phone }}</span>
		</p>
		<p>
			<strong style="color: #333;">Sujet:</strong>
			<span style="color: #555;">{{ type }}</span>
		</p>
		<p>
			<strong style="color: #333;">Message:</strong>
			<span>{{ message }}</span>
		</p>
	</div>
</div>
