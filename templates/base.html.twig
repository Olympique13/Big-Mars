<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}BigMars!
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

		{% block stylesheets %}
			<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
		{% endblock %}

		{% block javascripts %}
			<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
			{{ encore_entry_script_tags('app') }}
			<script src="/eventReg.js"></script>
			<script src="/contactForm.js"></script>
		{% endblock %}

		{% block js_custom %}{% endblock %}
	</head>
	<body class="font-sanstext-gray-800bg-gray-100overflow-x-hidden" id="body">
		{% for message in app.flashes('notice') %}
			<h2 class="alert alert-warning text-center mt-4 mb-4" role="alert">
				{{ message }}
			</h2>
		{% endfor %}

		<div class="main-content p-8 w-11/12 mx-auto my-8 bg-white border border-gray-200 rounded-lg shadow-lg flex justify-center flex-col"> {% block body %}{% endblock %}
			</div>
		</body>
	</html>
