{% extends 'base.html.twig' %}

{% block title %}Log in!
{% endblock %}

{% block body %}
	<section class="min-h-[80vh] flex justify-center items-center">
		<div class="flex flex-col items-center gap-5">
			<h1 class="h3 mb-3 font-weight-normal">Accès Back Office</h1>
			<form method="post" class="space-y-2">
				{% if error %}
					<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
				{% endif %}

				{# {% if app.user %}
					<div class="mb-3">
						Vos rôles :
						{{ app.user.roles|join(', ') }},
						<a href="{{ path('app_logout') }}">Logout</a>
					</div>
				{% endif %} #}

				<label class="hidden" for="username">Email</label>
				<input type="email" placeholder="Email" name="_username" id="username" class="form-control block text-gray-600" autocomplete="email" required="" autofocus="">
				<label class="hidden" for="password">Mot de passe </label>
				<input type="password" placeholder="Mot de passe" name="_password" id="password" class="text-gray-600 form-control block" autocomplete="current-password" required="">

				<button type="submit" class="btn !w-full text-white btn-bigMars">
					Se connecter
				</button>
			</form>
		</div>
	</section>
{% endblock %}
