<!-- Page wrapper -->
<div
	class="flex flex-col min-h-screen overflow-hidden">

	<!-- Page content -->
	<main class="grow">

		<section class="relative">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 relative">
				<div
					class="pt-32 pb-12 md:pt-40 md:pb-20">

					<!-- Page header -->
					<div class="max-w-3xl mx-auto text-center pb-12 md:pb-16">
						<h1 class="h1 mb-4">Inscrivez vous pour vivre un moment incroyable</h1>
						<p class="text-xl text-gray-600 dark:text-gray-400">Un email de confirmation vous sera envoyé lors de l'inscription</p>
					</div>

					<!-- Registration form -->
					<form class="max-w-xl mx-auto" method="post">
						{{ form_start(eventReg, { 'attr' : { 'class': 'max-w-lg mx-auto' } }) }}
						{{ form_errors(eventReg) }}
						<div class="flex flex-wrap -mx-3 mb-5">
							<div class="w-full md:w-1/2 px-3 mb-4 md:mb-0">
								{{ form_label(eventReg.lastName, "Nom", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}}) }}
								{{ form_widget(eventReg.lastName, {'attr': {'class': 'form-input w-full', 'placeholder': 'Entrez votre nom'}}) }}
								{{ form_errors(eventReg.lastName) }}
							</div>
							<div class="w-full md:w-1/2 px-3">
								{{ form_label(eventReg.firstName, "Prénom", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}}) }}
								{{ form_widget(eventReg.firstName, {'attr': {'class': 'form-input w-full', 'placeholder': 'Entrez votre prénom'}}) }}
								{{ form_errors(eventReg.firstName) }}
							</div>
						</div>
						<div class="flex flex-wrap -mx-3 mb-5">
							<div class="w-full px-3">
								{{ form_label(eventReg.email, "@Mail", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}}) }}
								{{ form_widget(eventReg.email, {'attr': {'class': 'form-input w-full', 'placeholder': 'Entrez votre adresse email'}}) }}
								{{ form_errors(eventReg.email) }}
							</div>
						</div>
						<div class="flex flex-wrap -mx-3 mb-5">
							<div class="w-full md:w-1/2 px-3 mb-4 md:mb-0">
								{{ form_label(eventReg.phone, "N° téléphone", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}}) }}
								{{ form_widget(eventReg.phone, {'attr': {'class': 'input-phone form-input w-full', 'placeholder': 'Entrez votre N° de téléphone'}}) }}
								{{ form_errors(eventReg.phone) }}
							</div>
							<div class="w-full md:w-1/2 px-3">
								{{ form_label(eventReg.zipCode, "Code Postal", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}}) }}
								{{ form_widget(eventReg.zipCode, {'attr': {'class': 'input-zipcode form-input w-full', 'placeholder': 'Entrez votre code postal'}}) }}
								{{ form_errors(eventReg.zipCode) }}
							</div>
						</div>
						<div class="flex flex-wrap -mx-3 mb-5">
							<div class="w-full md:w-1/2 px-3 mb-4 md:mb-0">
								{{ form_label(eventReg.birthDate, "Date de naissance", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}}) }}
								{{ form_widget(eventReg.birthDate, {'attr': {'class': 'input-birthDate form-input w-full', 'placeholder': 'JJ/MM/AAAA', 'type': 'text'}}) }}
								{{ form_errors(eventReg.birthDate) }}
							</div>
							<div class="w-full md:w-1/2 px-3">
								{{ form_label(eventReg.status, "Votre statut", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}}) }}
								{{ form_widget(eventReg.status, {'attr': {'class': 'input-zipcode form-input w-full', 'placeholder': 'Séléctionnez votre statut actuel'}}) }}
								{{ form_errors(eventReg.status) }}
							</div>
						</div>
						<div class="flex flex-wrap -mx-3 mb-5">
							<div class="w-full px-3">
								{{ form_label(eventReg.eventSlot, "Créneaux", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}}) }}
								{{ form_widget(eventReg.eventSlot, {'attr': {'class': 'form-input w-full'}}) }}
								{{ form_errors(eventReg.eventSlot) }}
							</div>
						</div>
						<div class="flex flex-wrap -mx-3 mt-6">
							<div class="w-full px-3">
								<button type="submit" class="btn text-white bg-teal-500 hover:bg-teal-400 w-full flex items-center">
									<span>S'inscrire</span>
									<svg class="w-3 h-3 shrink-0 mt-px ml-2" viewbox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
										<path class="fill-current" d="M6.602 11l-.875-.864L9.33 6.534H0v-1.25h9.33L5.727 1.693l.875-.875 5.091 5.091z"/>
									</svg>
								</button>
							</div>
						</div>
						{{ form_end(eventReg) }}
					</form>

				</div>
			</div>
		</section>

	</main>

</div>
