{%  extends 'base.html.twig' %}

{% block title %}Events
{% endblock %}

{% block js_custom %}
	{{ encore_entry_script_tags('home') }}
{% endblock %}

{% block body %}

	{% include 'event/register.html.twig' with {'id': events.id} %}

	<main class="pt-8 pb-16 lg:pt-16 lg:pb-24 bg-white antialiased" id="eventContent">
		<div class="flex justify-between px-4 mx-auto max-w-screen-xl">
			<article class="mx-auto w-full max-w-2xl format format-sm sm:format-base lg:format-lg format-blue dark:format-invert">
				<header class="mb-4 lg:mb-6 not-format">
					<img src="/images/events/{{ events.imageName }}" alt="{{ events.imageName }}">
					<address class="flex items-center mb-6 not-italic">
						<div class="inline-flex items-center mr-3 text-sm text-gray-900 dark:text-white">
							<div>
								<p class="text-base text-gray-500 dark:text-gray-400">
									Créer le :
									<time datetime="{{ events.createdAt|date('y/d/m')}}" title="{{ events.createdAt|date('y/d/m')}}">{{ events.createdAt|date('d/m/y')}}</time>
								</p>
							</div>
						</div>
					</address>
					<h1 class="mb-4 text-3xl font-extrabold leading-tight lg:mb-6 lg:text-4xl">{{ events.title }}
						{% for slot in eventSlots %}
							{% if loop.last and slot.dateEnd is defined and slot.dateEnd|date('d-m-y') < "now"|date('d-m-y') %}
								- Cet événement est fini
							{% endif %}
						{% endfor %}
					</h1>

				</header>
				<section class="main_review">
					<p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300">
						{{ events.content|raw }}
					</p>
				</section>
			</article>
		</div>

		<div class="flex justify-evenly mt-8 ">
			<a href="{{ path('app_event') }}" class="inline-block px-6 py-3 text-sm font-medium leading-6 text-center text-white transition bg-blue-600 rounded shadow ripple hover:shadow-lg hover:bg-blue-700 focus:outline-none">
				Retour aux événements
			</a>
			{% for slot in eventSlots %}
				{% if regCount < events.maxParticipant %}
					{% if loop.last and slot.dateEnd is defined and slot.dateEnd|date('d-m-y') > "now"|date('d-m-y') %}
						<button id="btEventReg" data-event-id="{{ events.id }}" class="inline-block px-6 py-3 text-sm font-medium leading-6 text-center text-white transition bg-green-600 rounded shadow ripple hover:shadow-lg hover:bg-green-700 focus:outline-none">
							S'inscrire
						</button>
					{% endif %}
				{% endif %}
			{% endfor %}
		</div>
	</main>
{% endblock %}
