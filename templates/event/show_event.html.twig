{% extends 'base.html.twig' %}

{% block title %}Events
{% endblock %}

{% block css_js_custom %}
    {{ encore_entry_link_tags('home') }}
    {{ encore_entry_script_tags('event') }}
{% endblock %}

{% block body %}

    <div class="flex flex-col min-h-screen overflow-hidden">

        <!-- Page content -->
        <main class="grow">

            <!-- Blog post -->
            <section class="relative">

                <!-- Background image -->
                <div class="absolute inset-0 h-128 pt-16 box-content">
                    <img class="absolute inset-0 w-full h-full object-cover opacity-25"
                         src="{{ asset('build/images/events/' ~ events.imageName) }}" width="1440" height="577"
                         alt="About"/>
                    <div class="absolute inset-0 bg-gradient-to-t from-white dark:from-gray-900"
                         aria-hidden="true"></div>
                </div>

                <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
                    <div class="py-32 pb-0 md:pt-40">
                        <div class="max-w-3xl mx-auto">

                            <article id="eventContent">
                                <!-- Article header -->
                                <header class="mb-8">
                                    <!-- Title and excerpt -->
                                    <div class="text-center md:text-left">
                                        <p class="text-3xl mb-4" data-aos="fade-down">{{ events.title }}</p>
                                        <p class="text-lg text-gray-600 dark:text-gray-400" data-aos="fade-down"
                                           data-aos-delay="150">{{ events.shortDescription }}</p>
                                    </div>
                                    <!-- Article meta -->
                                    <div data-aos="fade-down" class="bg-purple-50 p-6 mt-5 space-y-4">
                                        <div class="flex items-center gap-2">
                                            <div>
                                                <svg width="24px" height="24px" stroke-width="1.5" viewBox="0 0 24 24"
                                                     fill="none" xmlns="http://www.w3.org/2000/svg" color="#edc140">
                                                    <path d="M20 10C20 14.4183 12 22 12 22C12 22 4 14.4183 4 10C4 5.58172 7.58172 2 12 2C16.4183 2 20 5.58172 20 10Z"
                                                          stroke="#edc140" stroke-width="1.5"></path>
                                                    <path d="M12 11C12.5523 11 13 10.5523 13 10C13 9.44772 12.5523 9 12 9C11.4477 9 11 9.44772 11 10C11 10.5523 11.4477 11 12 11Z"
                                                          fill="#edc140" stroke="#edc140" stroke-width="1.5"
                                                          stroke-linecap="round" stroke-linejoin="round"></path>
                                                </svg>
                                            </div>
                                            <div>{{ events.place }}</div>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <div>
                                                <svg width="24px" height="24px" stroke-width="1.5" viewBox="0 0 24 24"
                                                     fill="none" xmlns="http://www.w3.org/2000/svg" color="#edc140">
                                                    <path d="M15 4V2M15 4V6M15 4H10.5M3 10V19C3 20.1046 3.89543 21 5 21H19C20.1046 21 21 20.1046 21 19V10H3Z"
                                                          stroke="#edc140" stroke-width="1.5" stroke-linecap="round"
                                                          stroke-linejoin="round"></path>
                                                    <path d="M3 10V6C3 4.89543 3.89543 4 5 4H7" stroke="#edc140"
                                                          stroke-width="1.5" stroke-linecap="round"
                                                          stroke-linejoin="round"></path>
                                                    <path d="M7 2V6" stroke="#edc140" stroke-width="1.5"
                                                          stroke-linecap="round" stroke-linejoin="round"></path>
                                                    <path d="M21 10V6C21 4.89543 20.1046 4 19 4H18.5" stroke="#edc140"
                                                          stroke-width="1.5" stroke-linecap="round"
                                                          stroke-linejoin="round"></path>
                                                </svg>
                                            </div>
                                            <div>
                                                {% set event = events.eventSlots|sort((a,b) => a.dateBegin <=> b.dateBegin)|first %}
                                                Le
                                                {{ event.dateBegin|format_datetime(locale: 'fr', pattern: 'd MMM Y') }}
                                                de
                                                {{ event.dateBegin|date('H') }}h{{ event.dateBegin|date('i') }}
                                                à
                                                {{ event.dateEnd|date('H') }}h{{ event.dateEnd|date('i') }}
                                            </div>
                                        </div>
                                    </div>
                                </header>
                                <hr class="w-5 h-px pt-px bg-gray-400 dark:bg-gray-500 border-0 mb-8" data-aos="fade-down" data-aos-delay="450"/>

                                <!-- Article content -->
                                <div class="text-lg text-gray-600 dark:text-gray-400 mb-1" data-aos="fade-up"
                                     data-aos-delay="450">

                                    <figure class="mb-8 mt-8">
                                        <img class="w-full" src="{{ asset('build/images/events/' ~ events.imageName) }}"
                                             width="768" height="432" alt="{{ events.title }}"/>
                                    </figure>

                                    <div>
                                        {{ events.content|raw }}
                                    </div>


                                    {% for slot in eventSlots %}
                                        {% if regCount < events.maxParticipant %}
                                            {% if slot.dateBegin|date('Y-m-d') > "now"|date('Y-m-d') %}
                                                {% if loop.first %}
                                                    <div class="flex flex-col overflow-hidden">
                                                        <main class="grow">
                                                            <section class="relative">
                                                                <div class="max-w-6xl mx-auto px-4 sm:px-6 relative">
                                                                    <div class="pt-16 pb-12">
                                                                        <div class="max-w-3xl text-balance mx-auto text-center pb-12 md:pb-16">
                                                                            <p class="text-2xl font-semibold mb-4">
                                                                                Inscrivez vous pour vivre un moment
                                                                                incroyable</p>
                                                                        </div>
                                                                        <!-- Registration form -->
                                                                        {{ form_start(eventReg, { 'attr' : {'id':'formEventReg', 'class': 'max-w-lg mx-auto' } }) }}
                                                                        {{ form_errors(eventReg) }}
                                                                        <div class="flex flex-wrap -mx-3 mb-5">
                                                                            <div class="w-full md:w-1/2 px-3 mb-4 md:mb-0">
                                                                                {{ form_label(eventReg.lastName, "Nom <span class='text-red-500'>*</span>", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}, 'label_html': true}) }}
                                                                                {{ form_widget(eventReg.lastName, {'attr': {'class': 'form-input w-full', 'placeholder': 'Entrez votre nom'}}) }}
                                                                                {{ form_errors(eventReg.lastName) }}
                                                                            </div>
                                                                            <div class="w-full md:w-1/2 px-3">
                                                                                {{ form_label(eventReg.firstName, "Prénom <span class='text-red-500'>*</span>", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}, 'label_html': true}) }}
                                                                                {{ form_widget(eventReg.firstName, {'attr': {'class': 'form-input w-full', 'placeholder': 'Entrez votre prénom'}}) }}
                                                                                {{ form_errors(eventReg.firstName) }}
                                                                            </div>
                                                                        </div>
                                                                        <div class="flex flex-wrap -mx-3 mb-5">
                                                                            <div class="w-full px-3">
                                                                                {{ form_label(eventReg.email, "Email <span class='text-red-500'>*</span>", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}, 'label_html': true}) }}
                                                                                {{ form_widget(eventReg.email, {'attr': {'class': 'form-input w-full', 'placeholder': 'Entrez votre adresse email'}}) }}
                                                                                {{ form_errors(eventReg.email) }}
                                                                            </div>
                                                                        </div>
                                                                        <div class="flex flex-wrap -mx-3 mb-5">
                                                                            <div class="w-full md:w-1/2 px-3 mb-4 md:mb-0">
                                                                                {{ form_label(eventReg.phone, "N° téléphone <span class='text-red-500'>*</span>", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}, 'label_html': true}) }}
                                                                                {{ form_widget(eventReg.phone, {'attr': {'class': 'input-phone form-input w-full', 'placeholder': 'Entrez votre N° de téléphone'}}) }}
                                                                                {{ form_errors(eventReg.phone) }}
                                                                            </div>
                                                                            <div class="w-full md:w-1/2 px-3">
                                                                                {{ form_label(eventReg.zipCode, "Code Postal <span class='text-red-500'>*</span>", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}, 'label_html': true}) }}
                                                                                {{ form_widget(eventReg.zipCode, {'attr': {'class': 'input-zipcode form-input w-full', 'placeholder': 'Entrez votre code postal'}}) }}
                                                                                {{ form_errors(eventReg.zipCode) }}
                                                                            </div>
                                                                        </div>
                                                                        <div class="flex flex-wrap -mx-3 mb-5">
                                                                            <div class="w-full md:w-1/2 px-3 mb-4 md:mb-0">
                                                                                {{ form_label(eventReg.birthDate, "Date de naissance <span class='text-red-500'>*</span>", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}, 'label_html': true}) }}
                                                                                {{ form_widget(eventReg.birthDate, {'attr': {'class': 'input-birthDate form-input w-full', 'placeholder': 'JJ/MM/AAAA', 'type': 'text'}}) }}
                                                                                {{ form_errors(eventReg.birthDate) }}
                                                                            </div>
                                                                            <div class="w-full md:w-1/2 px-3">
                                                                                {{ form_label(eventReg.status, "Votre statut <span class='text-red-500'>*</span>", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}, 'label_html': true}) }}
                                                                                {{ form_widget(eventReg.status, {'attr': {'class': 'input-zipcode form-input w-full', 'placeholder': 'Séléctionnez votre statut actuel'}}) }}
                                                                                {{ form_errors(eventReg.status) }}
                                                                            </div>
                                                                        </div>
                                                                        <div class="flex flex-wrap -mx-3 mb-5">
                                                                            <div class="w-full px-3">
                                                                                {{ form_label(eventReg.eventSlot, "Créneaux <span class='text-red-500'>*</span>", {'label_attr': {'class': 'block text-gray-800 dark:text-gray-300 text-sm font-medium mb-1'}, 'label_html': true}) }}
                                                                                {{ form_widget(eventReg.eventSlot, {'attr': {'class': 'form-input w-full'}}) }}
                                                                                {{ form_errors(eventReg.eventSlot) }}
                                                                            </div>
                                                                        </div>
                                                                        <div id="successEvent" style="display:none;"
                                                                             class="p-6 my-4 text-sm text-green-800 rounded-lg bg-green-50 dark:bg-gray-800 dark:text-green-400"
                                                                             role="alert">
                                                                            <span class="font-medium">Merci !</span>
                                                                            Votre inscription est validée, un email de
                                                                            confirmation vous a été envoyé.
                                                                        </div>
                                                                        <div id="errorEvent" style="display:none;"
                                                                             class="p-6 my-4 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400"
                                                                             role="alert">
                                                                            <span class="font-medium">Une erreur est survenue !</span>
                                                                            Veuillez réessayer.
                                                                        </div>
                                                                        <div class="flex flex-wrap -mx-3 mt-6">
                                                                            <div class="w-full px-3">
                                                                                <button type="submit"
                                                                                        class="btn text-white bg-teal-500 hover:bg-teal-400 w-full flex items-center">
                                                                                    <span>S'inscrire</span>
                                                                                    <svg class="w-3 h-3 shrink-0 mt-px ml-2"
                                                                                         viewbox="0 0 12 12"
                                                                                         xmlns="http://www.w3.org/2000/svg">
                                                                                        <path class="fill-current"
                                                                                              d="M6.602 11l-.875-.864L9.33 6.534H0v-1.25h9.33L5.727 1.693l.875-.875 5.091 5.091z"/>
                                                                                    </svg>
                                                                                </button>
                                                                            </div>
                                                                        </div>
                                                                        {{ form_end(eventReg) }}
                                                                    </div>
                                                                </div>
                                                            </section>

                                                        </main>

                                                    </div>

                                                {% endif %}
                                            {% else %}
                                                Cet événement est fini, aucune inscription n'est possible
                                            {% endif %}
                                        {% else %}
                                            Nous avons atteint le nombre maximum de participant pour cet événement, vous pourrez vous inscrire si une place se libère
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </article>

                        </div>
                    </div>
                </div>
            </section>

            <!-- Related posts -->
            <aside>
                <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
                    <div class="pb-12 md:pb-20">
                        <div class="max-w-3xl mx-auto">

                            <h4 class="h4 font-red-hat-display mb-8">Nos événements récents</h4>

                            <!-- événement container -->
                            <div class="grid gap-4 sm:gap-6 sm:grid-cols-2" data-aos-id-relposts>

                                <!-- liste de 2 événements -->
                                {% for events in event|slice(0, 2) %}
                                    <article class="relative group p-6 text-white" data-aos="fade-down" data-aos-anchor="[data-aos-id-relposts]">
                                    <a href="{{ path('show_event', {'slug': events.slug}) }}">
                                        <figure>
                                            <img class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-75 transition duration-700 ease-out"
                                                 src="{{ asset('build/images/events/' ~ events.imageName) }}"
                                                 width=" 372" height=" 182" alt="{{ events.title }}">
                                            <div class=" absolute inset-0 bg-yellow-100 opacity-75 group-hover:opacity-50 transition duration-700 ease-out"
                                                 aria-hidden=" true"></div>
                                        </figure>
                                        <div class="relative flex flex-col h-full">
                                            <header class="grow">
                                                <a class="hover:underline"
                                                   href="{{ path('show_event', {'slug': events.slug}) }}">
                                                    <h3 class="text-lg font-bold tracking-tight mb-2">
                                                        {{ events.title }}
                                                    </h3>
                                                </a>
                                                <div class="text-sm opacity-80">{{ events.shortDescription }}</div>
                                            </header>
                                            <footer class="mt-2">
												<span class="text-sm opacity-80">
                                                    {% if events.eventSlots|length > 1 %}
                                                        <p class="text-sm underline">Plusieurs dates disponibles</p>
                                                    {% else %}
                                                        {% for slot in events.eventSlots %}
                                                            Le {{ slot.dateBegin|date('d/m/y') }}
                                                        {% endfor %}
                                                    {% endif %}
												</span>
                                            </footer>
                                        </div>
                                    </a>
                                    </article>
                                {% endfor %}

                            </div>
                        </div>
                    </div>
                </div>
            </aside>

        </main>

    </div>


{% endblock %}
