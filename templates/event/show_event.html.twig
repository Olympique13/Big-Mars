{%  extends 'base.html.twig' %}

{% block title %}Events
{% endblock %}

{% block css_js_custom %}
	{{ encore_entry_link_tags('home') }}
	{{ encore_entry_script_tags('event') }}
{% endblock %}

{% block body %}

	<div
		class="flex flex-col min-h-screen overflow-hidden">

		<!-- Page content -->
		<main
			class="grow">

			<!-- Blog post -->
			<section
				class="relative">

				<!-- Background image -->
				<div class="absolute inset-0 h-128 pt-16 box-content">
					<img class="absolute inset-0 w-full h-full object-cover opacity-25" src="{{ asset('build/images/hero-bg.jpg') }}" width="1440" height="577" alt="About"/>
					<div class="absolute inset-0 bg-gradient-to-t from-white dark:from-gray-900" aria-hidden="true"></div>
				</div>

				<div class="relative max-w-6xl mx-auto px-4 sm:px-6">
					<div class="pt-32 pb-12 md:pt-40 md:pb-20">
						<div class="max-w-3xl mx-auto">

							<article
								id="eventContent">
								<!-- Article header -->
								<header
									class="mb-8">
									<!-- Title and excerpt -->
									<div class="text-center md:text-left">
										<h1 class="h1 font-red-hat-display mb-4" data-aos="fade-down">{{ events.title }}</h1>
										<p class="text-xl text-gray-600 dark:text-gray-400" data-aos="fade-down" data-aos-delay="150">{{ events.shortDescription}}</p>
									</div>
									<!-- Article meta -->
									<div
										class="md:flex md:items-center md:justify-between mt-5">
										<!-- Author meta -->
										<div class="flex items-center justify-center" data-aos="fade-down" data-aos-delay="300">
											<div>
												<span class="text-gray-600 dark:text-gray-400">
													{% if eventSlots|length > 1 %}
														Plusieurs dates disponibles
													{% else %}
														{% for slot in eventSlots %}
															Le
															{{slot.dateBegin|format_datetime(locale: 'fr', pattern: 'd MMM Y')}}
															de
															{{slot.dateBegin|date('H')}}h{{slot.dateBegin|date('i')}}
															à
															{{slot.dateEnd|date('H')}}h{{slot.dateEnd|date('i')}}
														{% endfor %}
													{% endif %}
												</span>
											</div>
										</div>
									</div>
								</header>
								<hr
								class="w-5 h-px pt-px bg-gray-400 dark:bg-gray-500 border-0 mb-8" data-aos="fade-down" data-aos-delay="450"/>

								<!-- Article content -->
								<div class="text-lg text-gray-600 dark:text-gray-400 mb-1" data-aos="fade-up" data-aos-delay="450">
									{{events.content|raw}}
									<figure class="mb-8 mt-8">
										<img class="w-full" src="/images/events/{{events.imageName}}" width="768" height="432" alt="News inner"/>
									</figure>

									{% for slot in eventSlots %}
										{% if regCount < events.maxParticipant %}
											{% if slot.dateBegin|date('Y-m-d') > "now"|date('Y-m-d') %}
												{% if loop.first %}
													{% include 'event/register.html.twig' with {'id': events.id} %}
												{% endif %}
											{% else %}
												Cet événement est fini, aucune inscription n'est possible
											{% endif %}
										{% else %}
											Nous avons atteint le nombre maximum de participant pour cet événement, vous pourrez vous inscrire si une place se libère
										{% endif %}
									{% endfor %}
								</div>

								<hr
								class="w-5 h-px pt-px bg-gray-400 dark:bg-gray-500 border-0 mb-8" data-aos="fade-down" data-aos-delay="450"/>

								<!-- Article footer -->
								<footer>
									<!-- Newsletter module -->
									<div class="dark bg-gray-800 py-8 px-8 md:py-12 md:px-12 text-center text-gray-100" data-aos="fade-down">
										<div class="text-xl font-medium mb-6">Abonnez vous à notre newsletter pour plus d'événements comme celui-ci
										</div>
										<form>
											<div class="relative flex flex-col sm:flex-row justify-center max-w-xs mx-auto sm:max-w-sm sm:px-4">
												<input type="email" class="form-input w-full px-4 py-2 mb-2 sm:mb-0 sm:mr-2" placeholder="Votre email" aria-label="Votre email"/>
												<a class="btn-sm text-white bg-teal-500 hover:bg-teal-400 shrink-0" href="#0">S'abonner</a>
												<svg class="hidden sm:block absolute left-full -mt-3" width="42" height="44" viewbox="0 0 42 44" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
													<path class="fill-current text-gray-600" d="M6.226 39.073l9.71 2.172-.436 1.951-13.436-3.004-1.735-.388 1.232-1.281 9.545-9.923 1.441 1.387-6.898 7.171 7.737-2.329C25.946 29.254 34.831 17.909 40.043.71l1.914.58c-5.378 17.746-14.651 29.572-27.818 35.393l-.117.043-7.796 2.347z"/>
												</svg>
											</div>
											<!-- Success message -->
											<!-- <p class="text-sm mt-2 opacity-80">Thanks for subscribing!</p> -->
											<p class="text-sm text-gray-400 italic mt-3">Pas de spam, que des bonnes nouvelles</p>
										</form>
									</div>
								</footer>

							</article>

						</div>
					</div>
				</div>
			</section>

			<!-- Related posts -->
			<aside>
				<div class="relative max-w-6xl mx-auto px-4 sm:px-6">
					<div class="pb-12 md:pb-20">
						<div class="max-w-3xl mx-auto">

							<h4 class="h4 font-red-hat-display mb-8">Nos événements récents</h4>

							<!-- événement container -->
							<div
								class="grid gap-4 sm:gap-6 sm:grid-cols-2" data-aos-id-relposts>

								<!-- liste de 2 événements -->
								{% for events in event|slice(0, 2) %}
									<article class="relative group p-6 text-white" data-aos="fade-down" data-aos-anchor="[data-aos-id-relposts]">
										<figure>
											<img class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-75 transition duration-700 ease-out" src="/images/events/{{ events.imageName }}" width=" 372" height=" 182" alt=" related post">
											<div class=" absolute inset-0 bg-teal-500 opacity-75 group-hover:opacity-50 transition duration-700 ease-out" aria-hidden=" true"></div>
										</figure>
										<div class="relative flex flex-col h-full">
											<header class="grow">
												<a class="hover:underline" href="blog-post.html">
													<h3 class="text-lg font-bold tracking-tight mb-2">
														{{events.title}}
													</h3>
												</a>
												<div class="text-sm opacity-80">{{events.shortDescription}}</div>
											</header>
											<footer class="mt-2">
												<span class="text-sm opacity-80">
													{% for slot in eventSlots %}
														Le
														{{slot.dateBegin|date('d/m/y')}}
													{% endfor %}
												</span>
											</footer>
										</div>
									</article>
								{% endfor %}

							</div>
						</div>
					</div>
				</div>
			</aside>

		</main>

	</div>


{% endblock %}
