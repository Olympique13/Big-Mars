{% extends 'base.html.twig' %}

{% block title %}Contact
{% endblock %}

{% block body %}

	<div class="container mx-auto" id="contactForm">
		<h1 class="text-2xl font-bold mb-5">S'inscrire</h1>

		{{ form_start(contactForm) }}
		{{ form_errors(contactForm) }}

		<div class="space-y-6">
			<div class="space-y-4">
				<div>
					{{ form_label(contactForm.lastName, "Nom", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
					{{ form_widget(contactForm.lastName, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md', 'placeholder': 'Nom'}}) }}
					{{ form_errors(contactForm.lastName) }}
				</div>
				<div>
					{{ form_label(contactForm.firstName, "Prénom", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
					{{ form_widget(contactForm.firstName, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md', 'placeholder': 'prenom'}}) }}
				</div>
				<div>
					{{ form_label(contactForm.email, "@Mail", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
					{{ form_widget(contactForm.email, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md', 'placeholder': 'Votre @Mail'}}) }}
					{{ form_errors(contactForm.email) }}
				</div>
				<div>
					{{ form_label(contactForm.phone, "N° Téléphone", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
					{{ form_widget(contactForm.phone, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md', 'placeholder': 'Votre numéro'}}) }}
				</div>
				<div>
					{{ form_label(contactForm.subject, "Sujet", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
					{{ form_widget(contactForm.subject, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md', 'placeholder': 'A quel sujet ?'}}) }}
				</div>
				<div>
					{{ form_label(contactForm.content, "Message", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
					{{ form_widget(contactForm.content, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md', 'placeholder': 'Votre message ici :'}}) }}
				</div>
			</div>
			<div>
				<button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">Envoyer</button>
			</div>
		</div>
		{{ form_end(contactForm) }}
	</div>

{% endblock %}
