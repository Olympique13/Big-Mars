{% block js_custom %}
	{{ encore_entry_script_tags('home') }}
{% endblock %}
<div class="container mx-auto" id="contactForm">
	<h1 class="text-2xl font-bold mb-5">Nous contacter</h1>

	{{ form_start(contactForm) }}
	{{ form_errors(contactForm) }}

	<div class="space-y-6">
		<div class="space-y-4">
			<div>
				{{ form_label(contactForm.lastName, "Nom", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(contactForm.lastName, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md', 'placeholder': 'Nom'}}) }}
				{{ form_errors(contactForm.lastName) }}
			</div>
			<div>
				{{ form_label(contactForm.firstName, "Prénom", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(contactForm.firstName, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md', 'placeholder': 'prenom'}}) }}
			</div>
			<div>
				{{ form_label(contactForm.email, "@Mail", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(contactForm.email, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md', 'placeholder': 'monemail@exemple.com'}}) }}
				{{ form_errors(contactForm.email) }}
			</div>
			<div>
				{{ form_label(contactForm.phone, "N° Téléphone", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(contactForm.phone, {'attr': {'class': 'input-phone mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md', 'placeholder': '06 XX XX XX XX'}}) }}
				{{ form_errors(contactForm.phone) }}
			</div>
			<div>
				{{ form_label(contactForm.type, "Vous êtes :", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(contactForm.type, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md'}}) }}
				{{ form_errors(contactForm.type) }}
			</div>
			{# Groupe "Company" #}
			<div id="company-group" style="display:none">
				{{ form_label(contactForm.company, "Nom de votre entreprise", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(contactForm.company, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md', 'placeholder': 'Veuillez entrez le nom de votre entreprise'}}) }}
				{{ form_errors(contactForm.company) }}
			</div>
			{# Fin de groupe "Company" #}
			{# Groupe "Talent" #}
			<div id="talent-group">
				<div>
					{{ form_label(contactForm.status, "Votre statut", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
					{{ form_widget(contactForm.status, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md'}}) }}
					{{ form_errors(contactForm.status) }}
				</div>
				<div>
					{{ form_label(contactForm.ageGroup, "Votre tranche d'âge", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
					{{ form_widget(contactForm.ageGroup, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md'}}) }}
					{{ form_errors(contactForm.ageGroup) }}
				</div>
			</div>
			{# Fin de groupe "Talent" #}
			<div>
				{{ form_label(contactForm.message, "Message", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(contactForm.message, {'attr': {'class': 'mt-1 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md', 'placeholder': 'Votre message ici :'}}) }}
				{{ form_errors(contactForm.message) }}
			</div>
			<div>
				{{ form_label(contactForm.agreeContact, "Accepter d'être recontacté par BigMars", {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
				{{ form_widget(contactForm.agreeContact) }}
				{{ form_errors(contactForm.agreeContact) }}
			</div>
		</div>
		<div>
			<button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">Envoyer</button>
		</div>
	</div>
	{{ form_end(contactForm) }}
</div>
